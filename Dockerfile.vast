# Custom nodes layer for comfyui-gputw on vast.ai.
# Builds on top of the base image (derekhsu/comfyui-gputw:<tag>) and adds
# user-selected custom nodes listed in custom-nodes.txt, plus the Civitai
# CLI for downloading models at runtime.
#
# Differences from Dockerfile.custom (gpuai version):
#   - No extra_model_paths.yaml: vast.ai volumes are local-only (tied to a
#     single physical machine), so baking model paths into the image is not
#     useful. Models are fetched at runtime via `hf download` (HuggingFace)
#     or `civitai download` (Civitai). Users who want a volume mount can
#     pass --model-paths-config /path/to/their.yaml via vast.ai --args.
#   - Civitai CLI is installed (single static Go binary) so users can
#     download Civitai models without extra setup.
#   - entrypoint-wrapper.vast.sh reads secrets from /data/secrets/ instead
#     of /vault/secrets/ (vast.ai volume default mount path is /data).
#
# Build args:
#   BASE_IMAGE          - full reference of the base image, e.g.
#                         derekhsu/comfyui-gputw:v0.30.0-cu128-pt2.6.0
#   CIVITAI_CLI_VERSION - civitai/cli release tag, e.g. v0.1.81
# amd64-only. Build with `docker buildx build --platform=linux/amd64 ...`.

ARG BASE_IMAGE=derekhsu/comfyui-gputw:dev
ARG CIVITAI_CLI_VERSION=v0.1.81

FROM ${BASE_IMAGE}

ARG CIVITAI_CLI_VERSION

# custom-nodes.txt format: <git_url>,<ref>
#   - git_url: HTTPS clone URL of the custom node repo
#   - ref:     branch, tag, or commit SHA (pinned for reproducibility)
# Lines starting with # are comments. Empty lines are ignored.
COPY custom-nodes.txt /tmp/custom-nodes.txt

WORKDIR ${COMFYUI_HOME}/custom_nodes

# Clone each node at the pinned ref and install its requirements if present.
# --depth 1 keeps the clone small. When ref is empty, no --branch flag is
# passed so git uses the repo's default branch (handles repos whose default
# is "master" or "Main" instead of "main"). When ref is specified, a failed
# --branch clone falls back to the default branch to keep the build resilient;
# remove the `|| git clone` fallback for strict pinning that fails on a bad ref.
RUN set -e; \
    while IFS=, read -r url ref; do \
      case "$url" in \#*|"") continue ;; esac; \
      [ -z "$url" ] && continue; \
      name=$(basename "$url" .git); \
      if [ -n "$ref" ]; then \
        echo "==> Cloning $name @ $ref"; \
        git clone --depth 1 --branch "$ref" "$url" "$name" 2>/dev/null || \
          git clone --depth 1 "$url" "$name"; \
      else \
        echo "==> Cloning $name @ default branch"; \
        git clone --depth 1 "$url" "$name"; \
      fi; \
      if [ -f "$name/requirements.txt" ]; then \
        echo "==> Installing requirements for $name"; \
        pip install --no-cache-dir -r "$name/requirements.txt"; \
      fi; \
    done < /tmp/custom-nodes.txt; \
    rm /tmp/custom-nodes.txt

# Install the Civitai CLI (single static Go binary from GitHub Releases).
# Reads CIVITAI_API_KEY (or CIVITAI_TOKEN) from the environment at runtime,
# so no login step is needed — the entrypoint wrapper exports the key from
# /data/secrets/env.sh or from vast.ai account/template env vars.
# `--layout comfyui` routes downloaded files into the right ComfyUI
# subfolder (checkpoints, loras, vae, ...) automatically.
RUN CIVITAI_VER="${CIVITAI_CLI_VERSION#v}"; \
    curl -fsSL -o /tmp/civitai.tar.gz \
        "https://github.com/civitai/cli/releases/download/${CIVITAI_CLI_VERSION}/civitai_${CIVITAI_VER}_linux_amd64.tar.gz" \
    && tar xzf /tmp/civitai.tar.gz -C /tmp civitai \
    && mv /tmp/civitai /usr/local/bin/civitai \
    && chmod +x /usr/local/bin/civitai \
    && rm -rf /tmp/civitai* \
    && civitai version

# Preset installer for fetching Hugging Face and Civitai models into ComfyUI's
# built-in models directory. This is intentionally only part of the Vast.ai
# image: the base image has no Civitai CLI and gpuai normally uses /vault.
RUN pip install --no-cache-dir pyyaml
COPY scripts/comfy_models.py /usr/local/bin/comfy-models
COPY presets/ /opt/comfyui/presets/
RUN chmod +x /usr/local/bin/comfy-models

# Entrypoint wrapper that loads secrets from /data/secrets/ at startup.
# This is set as the image ENTRYPOINT (not CMD) so it ALWAYS runs, even
# when vast.ai passes user-provided arguments via the Entrypoint launch
# mode (--args). The wrapper loads secrets, then exec's
# nvidia_entrypoint.sh (the base image's original entrypoint) with either
# the default ComfyUI command or the vast.ai-provided args. Missing volume
# files are silently skipped so the image boots fine without a volume.
COPY entrypoint-wrapper.vast.sh /opt/entrypoint-wrapper.sh
RUN chmod +x /opt/entrypoint-wrapper.sh

# Directory for LoraManager example images. LoraManager's settings.json
# (seeded from /data/secrets/lora-manager-settings.json by the wrapper when
# a volume is mounted, or configured at runtime otherwise) can point
# example_images_path here. The directory is empty at build time; populate
# it manually after SSH (no-volume mode) or sync from /data (volume mode).
RUN mkdir -p ${COMFYUI_HOME}/examples

# Reset to ComfyUI home so the wrapper script runs in the right directory.
WORKDIR ${COMFYUI_HOME}

# Replace the base ENTRYPOINT with our wrapper. No CMD is set — the
# wrapper always provides the default ComfyUI invocation and appends any
# vast.ai-provided args (which arrive as "$@") as extra parameters, so
# users only pass the flags they want to add or override.
#
# IMPORTANT: use the "docker ENTRYPOINT" launch mode on vast.ai. SSH/Jupyter
# launch modes replace the entrypoint with vast.ai's setup script, so this
# wrapper would NOT run and secrets would NOT be loaded.
ENTRYPOINT ["/opt/entrypoint-wrapper.sh"]
